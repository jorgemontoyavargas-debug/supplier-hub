# Use a long random value in any shared or production installation.
SUPPLIER_HUB_SECRET_KEY=replace-this-value
SUPPLIER_HUB_DEBUG=false
SUPPLIER_HUB_ALLOWED_HOSTS=localhost,127.0.0.1
SUPPLIER_HUB_TIME_ZONE=America/Bogota
SUPPLIER_HUB_HTTPS=true
SUPPLIER_HUB_HSTS_SECONDS=31536000
SUPPLIER_HUB_HSTS_PRELOAD=false
SUPPLIER_HUB_DB_ENGINE=sqlite

# PostgreSQL profile
SUPPLIER_HUB_DB_NAME=supplier_hub
SUPPLIER_HUB_DB_USER=supplier_hub
SUPPLIER_HUB_DB_PASSWORD=replace-this-password
SUPPLIER_HUB_DB_HOST=db
SUPPLIER_HUB_DB_PORT=5432
